# Copy this file to .env and fill in real values. .env is gitignored.

# Database
DB_URL=jdbc:postgresql://localhost:5432/ibnfirnas_db
DB_USERNAME=postgres
DB_PASSWORD=changeme

# Email (Gmail SMTP app password, not your account password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# JWT — generate a long random string, at least 256 bits
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION=86400000

# Optional overrides
SERVER_PORT=8080
