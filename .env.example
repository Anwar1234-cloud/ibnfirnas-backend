# Copy this file to .env and fill in real values. .env is gitignored.

# Database
DB_URL=jdbc:postgresql://localhost:5432/ibnfirnas_db
DB_USERNAME=postgres
DB_PASSWORD=changeme

# Email (Gmail SMTP app password, not your account password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# JWT — generate a long random string, at least 256 bits
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION=86400000

# Optional overrides
SERVER_PORT=8080

# CORS — comma-separated list of allowed frontend origins (admin panel, mobile app dev server, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:5173


# Google OAuth client ID — shared across the team, not a per-developer secret
GOOGLE_CLIENT_ID=282521229458-p7dk39mknn8dsc628bdc0q4qt6ba07bf.apps.googleusercontent.com

# Admin bootstrap — optional, one-time use. Leave both blank/unset for normal
# local dev (nothing happens if either is missing). Set both only when you
# need to provision the first admin account on a fresh database (e.g. a new
# production deploy) — creates a ROLE_ADMIN user on startup, then is a no-op
# on every later restart since the account will already exist. Log in and
# change the password immediately after first use.
# ADMIN_BOOTSTRAP_EMAIL=admin@ibnfirnas.com
# ADMIN_BOOTSTRAP_PASSWORD=change-this-immediately-after-first-login